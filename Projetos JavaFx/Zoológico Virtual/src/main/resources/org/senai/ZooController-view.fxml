<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="zoo-root" stylesheets="@styles/zoo.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.senai.Controller.ZooController">

    <Label styleClass="titulo" text="ZOOLÓGICO VIRTUAL" />

    <HBox styleClass="form-row">
        <Label text="Nome:" />
        <TextField fx:id="txtNome" promptText="Ex.: Rex" HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="form-row">
        <Label text="Idade:" />
        <TextField fx:id="txtIdade" promptText="Ex.: 3" HBox.hgrow="ALWAYS" />
    </HBox>

    <HBox styleClass="form-row">
        <Label text="Tipo:" />
        <ComboBox fx:id="cmbTipo" promptText="Selecione" />
    </HBox>

    <HBox styleClass="button-row" stylesheets="@styles/zoo.css">
        <Button onAction="#onAdicionar" styleClass="btn-primary" text="Cadastrar" />
        <Button onAction="#onEmitirSom" styleClass="btn-primary" text="Emitir Som" />
    </HBox>

    <ListView fx:id="lstAnimais" styleClass="lista" />

    <TextArea fx:id="txtSaida" editable="false" styleClass="saida" />
</VBox>
